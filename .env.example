# Copy to .env and fill in before running `make start`

APP_ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- Vector store ---
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=demo_corpus

# --- LLM / gateway ---
LLM_PROVIDER=litellm
OLLAMA_BASE_URL=http://ollama:11434
# Small, fast model — auto-pulled by docker-compose's ollama service on
# first container start (cached afterward), no manual "ollama pull" needed.
OLLAMA_DEFAULT_MODEL=llama3.2:1b
LITELLM_GATEWAY_URL=http://litellm:4000
LITELLM_DEFAULT_MODEL=primary-model
LITELLM_ADMIN_API_KEY=changeme-local-dev-key
GATEWAY_CACHE_ENABLED_DEFAULT=false
GATEWAY_ROUTING_ENABLED_DEFAULT=false

# --- MCP / Umaku ---
UMAKU_MCP_URL=https://mcp.umaku.ai/mcp
UMAKU_MCP_TOKEN=
# Required by every project-scoped Umaku tool this demo calls — find it
# in the Umaku platform UI for the dedicated demo project.
UMAKU_PROJECT_ID=

# --- Observability backend ---
OBSERVABILITY_BACKEND=langfuse
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# PHOENIX_INTERNAL_HOST: used by the backend container to export traces
# (Docker service name — leave as-is unless you change the compose
# service name). PHOENIX_HOST: used only for the trace_url link shown
# in the UI, which the presenter's browser opens directly — must be the
# host-mapped address, not the Docker-internal one.
PHOENIX_INTERNAL_HOST=http://phoenix:6006
PHOENIX_HOST=http://localhost:6006

# --- Evals ---
RAGAS_ENABLED=true
DEEPEVAL_ENABLED=true
# Judge LLM used by RAGAS/DeepEval to score faithfulness/relevancy.
# "openai" is the default judge provider; "anthropic" is supported as an
# alternate — set EVAL_JUDGE_MODEL accordingly (e.g. "gpt-4o-mini" vs
# "claude-3-5-sonnet-latest"). Only the key for the chosen provider is
# actually required at runtime, but both fields exist so switching is a
# one-line change.
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
